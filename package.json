{
  "name": "party-playlist-request",
  "version": "2.1.30",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "node server-https.js",
    "dev:https:real": "cross-env FORCE_REAL_SPOTIFY=true node server-https.js",
    "generate-certs": "node generate-certs.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf .next node_modules/.cache",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "db:migrate:canonical": "tsx scripts/db-migrate.ts",
    "db:migrate:canonical:dry": "tsx scripts/db-migrate.ts --dry-run",
    "db:migrate:canonical:list": "tsx scripts/db-migrate.ts --list",
    "db:backfill:class-c": "tsx scripts/backfill-prd03-prd04-class-c.ts",
    "db:generate": "echo \"DEPRECATED (PRD-05): drizzle-kit generate quarantined — use db:migrate:canonical\" && exit 1",
    "db:migrate": "echo \"DEPRECATED (PRD-05): use npm run db:migrate:canonical\" && exit 1",
    "db:push": "echo \"DEPRECATED (PRD-05): drizzle-kit push disabled — use db:migrate:canonical\" && exit 1",
    "db:studio": "echo \"DEPRECATED (PRD-05): drizzle-kit studio disabled — schema is canonical SQL\" && exit 1",
    "db:migrate-data": "echo \"DEPRECATED (PRD-05): 7→4 migrator quarantined under src/lib/db/_quarantine\" && exit 1",
    "db:migrate-dry-run": "npm run db:migrate:canonical:dry",
    "db:validate-migration": "npm run db:migrate:canonical:list",
    "db:create-indexes": "echo \"DEPRECATED (PRD-05): indexes.ts targets spotify_tokens — quarantined; use canonical SQL\" && exit 1",
    "db:analyze-performance": "echo \"DEPRECATED (PRD-05): indexes.ts targets spotify_tokens — quarantined\" && exit 1",
    "db:create-constraints": "echo \"DEPRECATED (PRD-05): constraints.ts targets spotify_tokens — quarantined; use canonical SQL\" && exit 1",
    "db:validate-data": "echo \"DEPRECATED (PRD-05): constraints.ts targets spotify_tokens — quarantined\" && exit 1",
    "test": "npm run test:unit",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "test:browser:dj": "tsx scripts/run-browser-tests.ts --flow=dj",
    "test:browser:guest": "tsx scripts/run-browser-tests.ts --flow=guest",
    "test:unit": "jest --config config/jest/jest.unit.config.ts",
    "test:components": "jest --config config/jest/jest.unit.config.ts --testPathPatterns=__tests__",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:api": "jest --config config/jest/jest.api.config.ts",
    "test:full": "tsx scripts/run-tests.ts",
    "test:setup-db": "tsx scripts/setup-test-db.ts",
    "test:seed-db": "tsx scripts/seed-test-data.ts",
    "test:cleanup-db": "tsx scripts/cleanup-test-data.ts",
    "finalise": "tsx scripts/finalise.ts",
    "finalise:push": "tsx scripts/finalise.ts --push",
    "finalise:full": "tsx scripts/finalise.ts --full",
    "finalise:full:push": "tsx scripts/finalise.ts --full --push",
    "fixerrors": "tsx scripts/fixerrors.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.1",
    "@tanstack/react-query": "^5.62.3",
    "@types/qrcode": "^1.5.5",
    "@upstash/redis": "^1.35.4",
    "@vercel/kv": "^3.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.5",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.543.0",
    "next": "15.5.9",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.2.8",
    "resend": "^6.1.2",
    "stripe": "^18.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "https-localhost": "^4.7.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.0",
    "kill-port": "^2.0.1",
    "msw": "^2.8.0",
    "playwright": "^1.55.0",
    "rimraf": "^6.0.1",
    "selfsigned": "^3.0.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
