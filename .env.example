# Party Playlist - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# DATABASE
DATABASE_URL=postgresql://username:password@host:5432/database_name

# AUTHENTICATION
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# Optional keyed HMAC for event access codes (PRD-04). Falls back to JWT_SECRET when unset.
# ACCESS_CODE_HMAC_SECRET=your_random_access_code_hmac_secret

# Auth rate-limit HMAC salt (falls back to IP_SALT). Required in production for auth throttling.
# AUTH_RATE_LIMIT_SALT=your_random_auth_rate_limit_salt

# Upstash Redis — recommended in production for distributed guest + auth rate limits,
# playback refresh debounce, and cross-instance coordination (PRD-06).
# When unset: auth/guest limiters fall back to process-local memory (never unbounded).
# Playback refresh still uses Neon lease; Redis adds cross-instance debounce when present.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# SPOTIFY API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# Token vault (AES-256-GCM). Required in production. 32-byte key as base64 or 64-char hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_V1=
# Optional rotation read key + active write kid (default write kid = v1)
# TOKEN_ENCRYPTION_KEY_V2=
# TOKEN_ENCRYPTION_WRITE_KID=v1

# PUSHER (Real-time Updates)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster

# EMAIL (Resend)
RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=PartyPlaylist <noreply@yourdomain.com>
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# APPLICATION
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: pg pool size for serverless (default 10)
# PG_POOL_MAX=10

# CLI-only schema bootstrap fallback (never set on Vercel request handlers)
# ALLOW_DB_BOOTSTRAP=1

# Prefer: npm run db:migrate:canonical

# Vercel Cron (optional locally; required in production for /api/cron/spotify-sync)
# Vercel injects Authorization: Bearer <CRON_SECRET> on cron invocations when set.
CRON_SECRET=your_cron_secret

# PRD-08 beta entitlement gate (production enforces grants by default)
# Local/dev skips the gate unless BETA_ENTITLEMENT_ENFORCE=1
# BETA_ENTITLEMENT_ENFORCE=1
# BETA_ENTITLEMENT_BYPASS=1

# Required in production (fail-closed). Dev/test may omit and use local defaults.
# IP_SALT=your_random_ip_salt
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=eu
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=eu
